#!/usr/bin/env bash
# Copyright (c) 2024-2026 Eduardo Correia <ecorreia@apliant.com.br>
# SPDX-License-Identifier: LGPL-3.0-or-later
#
# Git pre-commit hook for Bake Linter
# Lints staged .bb, .bbappend, and .inc files before commit
#
# Installation, from inside the repository whose recipes you want linted:
#   /path/to/bake_linter/hooks/install-hooks.sh
#
# or link it by hand:
#   ln -sf /path/to/bake_linter/hooks/pre-commit "$(git rev-parse --git-path hooks)/pre-commit"
#

set -euo pipefail

# Colors (disabled if not a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    BOLD='\033[1m'
    NC='\033[0m' # No Color
else
    RED='' GREEN='' YELLOW='' BLUE='' BOLD='' NC=''
fi

# The bake_linter checkout this hook belongs to: the hook is installed as a
# symlink, so resolve it to find the checkout next to the real file.
HOOK_PATH=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
LINTER_DIR=$(cd "$(dirname "$HOOK_PATH")/.." && pwd)

# Get staged recipe files (only added, copied, modified, renamed)
STAGED_RECIPES=()
while IFS= read -r -d '' FILE; do
    case "$FILE" in
        *.bb|*.bbappend|*.inc) STAGED_RECIPES+=("$FILE") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# Skip if no recipe files staged
if [ ${#STAGED_RECIPES[@]} -eq 0 ]; then
    exit 0
fi

echo -e "${BLUE}${BOLD}━━━ Bake Linter ━━━${NC}"
echo ""

# Count files
FILE_COUNT=${#STAGED_RECIPES[@]}
echo -e "${BOLD}Checking ${FILE_COUNT} staged recipe file(s):${NC}"
printf '  %s\n' "${STAGED_RECIPES[@]}"
echo ""

# Check if linter is available
if command -v bake-linter &> /dev/null; then
    LINTER_CMD=(bake-linter)
elif [ -f "${LINTER_DIR}/.venv/bin/bake-linter" ]; then
    LINTER_CMD=("${LINTER_DIR}/.venv/bin/bake-linter")
elif [ -f "${LINTER_DIR}/bake_linter/cli.py" ]; then
    # Fallback: run directly with Python
    if [ -f "${LINTER_DIR}/.venv/bin/python" ]; then
        LINTER_CMD=("${LINTER_DIR}/.venv/bin/python" -m bake_linter.cli)
    else
        LINTER_CMD=(python3 -m bake_linter.cli)
    fi
    export PYTHONPATH="${LINTER_DIR}:${PYTHONPATH:-}"
else
    echo -e "${RED}✗ Bake Linter not found - commit blocked.${NC}"
    echo -e "  Install with: ${BOLD}pip install -e ${LINTER_DIR}${NC}"
    exit 1
fi

# Create temp directory for staged file contents
TEMP_DIR=$(mktemp -d)
trap 'rm -rf -- "$TEMP_DIR"' EXIT

# Extract staged versions of files (not working tree versions)
# This ensures we lint what's actually being committed
STAGED_FILES=()
for FILE in "${STAGED_RECIPES[@]}"; do
    mkdir -p "${TEMP_DIR}/$(dirname "$FILE")"
    if ! git show ":${FILE}" > "${TEMP_DIR}/${FILE}"; then
        echo "Cannot read staged file: $FILE" >&2
        exit 1
    fi
    STAGED_FILES+=("${TEMP_DIR}/${FILE}")
done

# Run linter
echo -e "${BOLD}Running linter...${NC}"
echo ""

# Run linter and capture exit code
printf 'command line:'
printf ' %q' "${LINTER_CMD[@]}" --ci "${STAGED_FILES[@]}"
printf '\n'
set +e
"${LINTER_CMD[@]}" --ci "${STAGED_FILES[@]}"
LINT_EXIT_CODE=$?
set -e

echo ""

if [ $LINT_EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}${BOLD}✓ All checks passed${NC}"
    exit 0
elif [ $LINT_EXIT_CODE -eq 1 ]; then
    echo -e "${YELLOW}${BOLD}⚠ Warnings found (commit allowed)${NC}"
    exit 0
elif [ $LINT_EXIT_CODE -eq 2 ]; then
    echo -e "${RED}${BOLD}✗ Errors found - commit blocked${NC}"
    echo ""
    echo -e "Fix the issues above or bypass with: ${BOLD}git commit --no-verify${NC}"
    exit 1
else
    # 3 is a configuration or runtime error; anything else is a crash.
    # Block: the recipes were not checked.
    echo -e "${RED}${BOLD}✗ Linter failed (exit code ${LINT_EXIT_CODE}) - commit blocked${NC}"
    echo ""
    echo -e "Fix the linter setup or bypass with: ${BOLD}git commit --no-verify${NC}"
    exit 1
fi
