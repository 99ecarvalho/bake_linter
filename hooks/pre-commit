#!/usr/bin/env bash
#
# Git pre-commit hook for Bake Linter
# Lints staged .bb, .bbappend, and .inc files before commit
#
# Installation:
#   ln -sf ../../tools/bake_linter/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or run: tools/bake_linter/hooks/install-hooks.sh
#

set -euo pipefail

# Colors (disabled if not a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    BOLD='\033[1m'
    NC='\033[0m' # No Color
else
    RED='' GREEN='' YELLOW='' BLUE='' BOLD='' NC=''
fi

# Get repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
LINTER_DIR="${REPO_ROOT}/tools/bake_linter"

# Get staged recipe files (only added, copied, modified, renamed)
STAGED_RECIPES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(bb|bbappend|inc)$' || true)

# Skip if no recipe files staged
if [ -z "$STAGED_RECIPES" ]; then
    exit 0
fi

echo -e "${BLUE}${BOLD}━━━ Bake Linter ━━━${NC}"
echo ""

# Count files
FILE_COUNT=$(echo "$STAGED_RECIPES" | wc -l | tr -d ' ')
echo -e "${BOLD}Checking ${FILE_COUNT} staged recipe file(s):${NC}"
echo "$STAGED_RECIPES" | sed 's/^/  /'
echo ""

# Check if linter is available
if command -v bake-linter &> /dev/null; then
    LINTER_CMD="bake-linter"
elif [ -f "${LINTER_DIR}/.venv/bin/bake-linter" ]; then
    LINTER_CMD="${LINTER_DIR}/.venv/bin/bake-linter"
elif [ -f "${LINTER_DIR}/bake_linter/cli.py" ]; then
    # Fallback: run directly with Python
    if [ -f "${LINTER_DIR}/.venv/bin/python" ]; then
        LINTER_CMD="${LINTER_DIR}/.venv/bin/python -m bake_linter"
    else
        LINTER_CMD="python3 -m bake_linter"
    fi
    export PYTHONPATH="${LINTER_DIR}:${PYTHONPATH:-}"
else
    echo -e "${YELLOW}⚠ Bake Linter not found. Skipping check.${NC}"
    echo -e "  Install with: ${BOLD}pip install -e ${LINTER_DIR}${NC}"
    exit 0
fi

# Create temp directory for staged file contents
TEMP_DIR=$(mktemp -d)
trap "rm -rf ${TEMP_DIR}" EXIT

# Extract staged versions of files (not working tree versions)
# This ensures we lint what's actually being committed
STAGED_FILES=""
for FILE in $STAGED_RECIPES; do
    if [ -f "$FILE" ]; then
        # Create directory structure in temp
        mkdir -p "${TEMP_DIR}/$(dirname "$FILE")"
        # Get staged content
        git show ":${FILE}" > "${TEMP_DIR}/${FILE}" 2>/dev/null || continue
        STAGED_FILES="${STAGED_FILES} ${TEMP_DIR}/${FILE}"
    fi
done

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ No valid staged files to lint${NC}"
    exit 0
fi

# Run linter
echo -e "${BOLD}Running linter...${NC}"
echo ""

# Run linter and capture exit code
echo "command line: [$LINTER_CMD --ci $STAGED_FILES]"
set +e
$LINTER_CMD --ci $STAGED_FILES
LINT_EXIT_CODE=$?
set -e

echo ""

if [ $LINT_EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}${BOLD}✓ All checks passed${NC}"
    exit 0
elif [ $LINT_EXIT_CODE -eq 1 ]; then
    echo -e "${YELLOW}${BOLD}⚠ Warnings found (commit allowed)${NC}"
    exit 0
else
    echo -e "${RED}${BOLD}✗ Errors found - commit blocked${NC}"
    echo ""
    echo -e "Fix the issues above or bypass with: ${BOLD}git commit --no-verify${NC}"
    exit 1
fi
